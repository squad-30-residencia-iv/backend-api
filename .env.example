# Copie este arquivo para ".env" na raiz do repositório e ajuste os valores.
# As chaves sobrescrevem a seção "Database" do appsettings.json ("__" equivale a ":").
# Variáveis já definidas no ambiente têm precedência sobre o .env.

# Banco local/emulado (padrão enquanto o banco oficial não está provisionado)
Database__Provider=Sqlite
Database__ConnectionString="Data Source=vouchercampaigns.db"

# Banco relacional oficial (PostgreSQL)
# Database__Provider=Postgres
# Database__ConnectionString="Host=localhost;Port=5432;Database=vouchercampaigns;Username=postgres;Password=postgres"
