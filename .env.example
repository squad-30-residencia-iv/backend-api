# Copie este arquivo para ".env" na raiz do repositório e ajuste os valores.
# As chaves sobrescrevem a seção "Database" do appsettings.json ("__" equivale a ":").
# Variáveis já definidas no ambiente têm precedência sobre o .env.

# Banco local/emulado (padrão quando não há .env)
Database__Provider=Sqlite
Database__ConnectionString="Data Source=vouchercampaigns.db"

# PostgreSQL local via Docker (suba antes com: docker compose up -d)
# Database__Provider=Postgres
# Database__ConnectionString="Host=localhost;Port=5432;Database=vouchercampaigns;Username=postgres;Password=postgres"

# Supabase (PostgreSQL gerenciado): use a connection string do painel do projeto
# (conexão direta ou "Session pooler"), sempre com SSL.
# Database__Provider=Postgres
# Database__ConnectionString="Host=<host-do-supabase>;Port=5432;Database=postgres;Username=<usuario>;Password=<senha>;SSL Mode=Require"

# Dados de demonstração (1 rede, 1 região, 3 lojas, 3 categorias, 3 produtos).
# Já vem ligado em appsettings.Development.json; nunca ligue em produção.
# Database__SeedDemoData=true

# Chave de assinatura do JWT (mínimo de 32 caracteres). Obrigatória fora de Development;
# em Development já vem uma chave local no appsettings.Development.json.
# Auth__Jwt__SigningKey="troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres"
